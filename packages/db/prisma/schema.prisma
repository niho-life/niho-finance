// NIHO finance data model. Design: docs/design/01-domain-model.md
//
// Conventions
// - Tables and columns are snake_case (@@map / @map).
// - IDs are ULIDs generated by the application (src/ids.ts).
// - Money is JPY as BigInt. Accounting dates are @db.Date (no time). Timestamps are timestamptz.
// - Guards Prisma cannot express (append-only ledger, deferred balance check, CHECK constraints)
//   live in the hand-written migration `*_ledger_guards`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum FiscalYearStatus {
  open
  closing
  closed

  @@map("fiscal_year_status")
}

enum ConsumptionTaxMethod {
  exempt
  general
  simplified

  @@map("consumption_tax_method")
}

enum AccountingMethod {
  tax_inclusive
  tax_exclusive

  @@map("accounting_method")
}

enum AccountKind {
  asset
  liability
  equity
  revenue
  expense
  internal

  @@map("account_kind")
}

enum AccountGroup {
  current_assets
  fixed_assets
  deferred_assets
  current_liabilities
  fixed_liabilities
  shareholders_equity
  sales
  cost_of_sales
  sga
  non_operating_income
  non_operating_expenses
  extraordinary_income
  extraordinary_losses
  income_taxes
  internal

  @@map("account_group")
}

enum TaxDirection {
  sales
  purchase
  none

  @@map("tax_direction")
}

enum TaxKind {
  taxable
  exempt
  out_of_scope
  export
  na

  @@map("tax_kind")
}

enum PartnerKind {
  customer
  vendor
  both
  other

  @@map("partner_kind")
}

enum InvoiceRegistrationStatus {
  unknown
  verified
  not_found
  revoked

  @@map("invoice_registration_status")
}

enum WalletKind {
  bank
  card
  cash
  stripe
  owner
  other

  @@map("wallet_kind")
}

enum WalletTransactionStatus {
  pending
  registered
  transfer
  ignored

  @@map("wallet_transaction_status")
}

enum ImportSource {
  csv
  stripe
  api

  @@map("import_source")
}

enum EntryKind {
  opening
  normal
  transfer
  adjusting
  closing
  reversal

  @@map("entry_kind")
}

enum SourceKind {
  manual
  wallet_txn
  stripe
  invoice
  fixed_asset
  recurring
  import
  system
  payroll
  /// Year-end entries not about one fixed asset (繰延資産の償却・前払未払・消費税・法人税等・決算振替)
  year_end
  /// 立替精算: the accrual of a claim (sourceId = the claim) and its payment (sourceId = the payment)
  expense

  @@map("source_kind")
}

enum EntryStatus {
  posted
  voided

  @@map("entry_status")
}

enum Side {
  debit
  credit

  @@map("side")
}

enum DocumentKind {
  receipt
  invoice_in
  invoice_out
  contract
  statement
  other

  @@map("document_kind")
}

enum DocumentSource {
  upload
  camera
  email
  stripe
  generated

  @@map("document_source")
}

enum DocumentStatus {
  inbox
  linked
  voided

  @@map("document_status")
}

enum InvoiceDocType {
  quote
  delivery
  invoice

  @@map("invoice_doc_type")
}

enum InvoiceStatus {
  draft
  issued
  sent
  paid
  void

  @@map("invoice_status")
}

enum DepreciationMethod {
  straight_line
  declining_balance
  immediate
  lump_sum_3y

  @@map("depreciation_method")
}

enum RecurrenceFrequency {
  monthly
  yearly

  @@map("recurrence_frequency")
}

enum CalendarItemKind {
  filing
  payment
  notification
  meeting
  other

  @@map("calendar_item_kind")
}

enum UserRole {
  owner
  accountant
  viewer

  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

/// The company (one row). Real identifiers live only in the database, never in the repository.
model Company {
  id                        String    @id
  name                      String
  nameKana                  String?   @map("name_kana")
  /// 法人番号 (13 digits)
  corporateNumber           String?   @map("corporate_number")
  /// T + 13 digits, once registered
  invoiceRegistrationNumber String?   @map("invoice_registration_number")
  /// 登録日 of the qualified invoice issuer registration
  invoiceRegisteredOn       DateTime? @map("invoice_registered_on") @db.Date
  address                   String?
  representative            String?
  /// 設立日: the first fiscal year starts on this date
  foundedOn                 DateTime  @map("founded_on") @db.Date
  /// First month of the fiscal year (決算月 + 1, e.g. 4 for a March close)
  fiscalYearStartMonth      Int       @map("fiscal_year_start_month")
  /// Bank account printed on invoices (v2)
  bankAccountForInvoice     Json?     @map("bank_account_for_invoice")
  /// Setup wizard: the 口座 step was postponed (「あとで」). Wallets can be added in the settings.
  setupWalletsSkippedAt     DateTime? @map("setup_wallets_skipped_at") @db.Timestamptz(6)
  /// Setup wizard: the 開始仕訳 step was postponed (「あとで」).
  setupOpeningSkippedAt     DateTime? @map("setup_opening_skipped_at") @db.Timestamptz(6)
  /// 証憑の規程 (電子取引データの事務処理規程): 施行日. Set = the policy is in force.
  recordsPolicyEffectiveOn  DateTime? @map("records_policy_effective_on") @db.Date
  /// 証憑の規程: 管理責任者
  recordsPolicyManager      String?   @map("records_policy_manager")
  /// 証憑の規程: 処理責任者
  recordsPolicyOperator     String?   @map("records_policy_operator")
  /// 証憑の規程: version of the text that was put in force (POLICY_VERSION of the app)
  recordsPolicyVersion      String?   @map("records_policy_version")
  /// 償却資産申告の申告先 (本店所在地の市町村)
  propertyTaxMunicipality   String?   @map("property_tax_municipality")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  fiscalYears FiscalYear[]

  @@map("company")
}

model FiscalYear {
  id                String               @id
  companyId         String               @map("company_id")
  /// 第 n 期
  no                Int
  startDate         DateTime             @map("start_date") @db.Date
  endDate           DateTime             @map("end_date") @db.Date
  status            FiscalYearStatus     @default(open)
  consumptionTax    ConsumptionTaxMethod @map("consumption_tax")
  accountingMethod  AccountingMethod     @map("accounting_method")
  /// Monthly close: no posting or voiding on or before this date
  lockedThrough     DateTime?            @map("locked_through") @db.Date
  /// Next JournalEntry.no to assign. Incremented in the posting transaction (no gaps).
  nextEntryNo       Int                  @default(1) @map("next_entry_no")
  /// Year-end checklist confirmations: { balances?: { at, actor }, accruals?: { at, actor } }
  yearEndChecks     Json?                @map("year_end_checks")
  /// 決算書の設定 (17-financial-statements §3.1): words and dates of the statements, never numbers
  statementSettings Json?                @map("statement_settings")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company        @relation(fields: [companyId], references: [id])
  journalEntries JournalEntry[]
  calendarItems  CalendarItem[]

  @@unique([companyId, no])
  @@index([startDate, endDate])
  @@map("fiscal_year")
}

model Account {
  id                     String       @id
  /// 4 digits; also the sort key
  code                   String       @unique
  name                   String
  kind                   AccountKind
  /// Statement presentation group (決算書の表示区分)
  group                  AccountGroup @map("statement_group")
  defaultTaxCategoryCode String?      @map("default_tax_category_code")
  defaultSegmentId       String?      @map("default_segment_id")
  /// Counted in the cash report (cash, deposits, Stripe balance)
  isCashLike             Boolean      @default(false) @map("is_cash_like")
  /// e-Tax financial statements CSV (HOT010) mapping (v2)
  eTaxCode               String?      @map("e_tax_code")
  eTaxHierarchy          Int?         @map("e_tax_hierarchy")
  eTaxRowKind            String?      @map("e_tax_row_kind")
  isActive               Boolean      @default(true) @map("is_active")
  sortOrder              Int          @default(0) @map("sort_order")
  note                   String?
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  defaultTaxCategory TaxCategory?    @relation(fields: [defaultTaxCategoryCode], references: [code])
  defaultSegment     Segment?        @relation(fields: [defaultSegmentId], references: [id])
  subAccounts        SubAccount[]
  journalLines       JournalLine[]
  wallets            Wallet[]
  partnerDefaults    Partner[]
  fixedAssets        FixedAsset[]
  recurringItems     RecurringItem[]
  invoices           Invoice[]
  expenseClaims      ExpenseClaim[]

  @@map("account")
}

model SubAccount {
  id        String   @id
  accountId String   @map("account_id")
  name      String
  /// Set for per-partner sub-accounts (e.g. 売掛金 / 取引先 A)
  partnerId String?  @map("partner_id")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account      Account       @relation(fields: [accountId], references: [id])
  partner      Partner?      @relation(fields: [partnerId], references: [id])
  journalLines JournalLine[]
  wallets      Wallet[]

  @@unique([accountId, name])
  @@map("sub_account")
}

/// Aggregation bucket of the consumption tax return. Rates and periods are in TaxRateRule.
model TaxCategory {
  id        String       @id
  code      String       @unique
  name      String
  direction TaxDirection
  kind      TaxKind
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  rules           TaxRateRule[]
  accounts        Account[]
  journalLines    JournalLine[]
  partnerDefaults Partner[]
  recurringItems  RecurringItem[]
  expenseClaims   ExpenseClaim[]

  @@map("tax_category")
}

model TaxRateRule {
  id                String    @id
  taxCategoryCode   String    @map("tax_category_code")
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  /// Inclusive; null = open-ended
  effectiveTo       DateTime? @map("effective_to") @db.Date
  ratePercent       Int       @map("rate_percent")
  /// Purchase tax credit ratio in percent; null when not a taxable purchase
  deductiblePercent Int?      @map("deductible_percent")
  /// Disabled rows are kept as data (e.g. a bill not yet enacted)
  enabled           Boolean   @default(true)
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxCategory TaxCategory @relation(fields: [taxCategoryCode], references: [code])

  @@unique([taxCategoryCode, effectiveFrom, ratePercent])
  @@map("tax_rate_rule")
}

model Segment {
  id        String   @id
  /// platform / kamakura / contract / corporate
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  accountDefaults Account[]
  journalLines    JournalLine[]
  wallets         Wallet[]
  partnerDefaults Partner[]
  fixedAssets     FixedAsset[]
  recurringItems  RecurringItem[]
  invoices        Invoice[]
  expenseClaims   ExpenseClaim[]

  @@map("segment")
}

model Partner {
  id                           String                    @id
  name                         String
  nameKana                     String?                   @map("name_kana")
  kind                         PartnerKind
  invoiceRegistrationNumber    String?                   @map("invoice_registration_number")
  invoiceRegistrationStatus    InvoiceRegistrationStatus @default(unknown) @map("invoice_registration_status")
  invoiceRegistrationCheckedAt DateTime?                 @map("invoice_registration_checked_at") @db.Timestamptz(6)
  /// The registry's published name, registration date and end (失効・取消, the earlier); read only
  /// while the status is not `unknown` (20-reader §7.1)
  invoiceRegistrationName      String?                   @map("invoice_registration_name")
  invoiceRegisteredOn          DateTime?                 @map("invoice_registered_on") @db.Date
  invoiceRegistrationEndedOn   DateTime?                 @map("invoice_registration_ended_on") @db.Date
  defaultAccountId             String?                   @map("default_account_id")
  defaultSegmentId             String?                   @map("default_segment_id")
  defaultTaxCategoryCode       String?                   @map("default_tax_category_code")
  email                        String?
  address                      String?
  note                         String?
  isActive                     Boolean                   @default(true) @map("is_active")
  createdAt                    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  defaultAccount     Account?        @relation(fields: [defaultAccountId], references: [id])
  defaultSegment     Segment?        @relation(fields: [defaultSegmentId], references: [id])
  defaultTaxCategory TaxCategory?    @relation(fields: [defaultTaxCategoryCode], references: [code])
  subAccounts        SubAccount[]
  journalLines       JournalLine[]
  documents          Document[]
  invoices           Invoice[]
  recurringItems     RecurringItem[]
  expenseClaims      ExpenseClaim[]

  @@map("partner")
}

model MemoTag {
  id        String   @id
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lines JournalLineMemoTag[]

  @@map("memo_tag")
}

// ---------------------------------------------------------------------------
// Wallets and statement lines
// ---------------------------------------------------------------------------

model Wallet {
  id                   String     @id
  name                 String
  kind                 WalletKind
  accountId            String     @map("account_id")
  subAccountId         String?    @map("sub_account_id")
  /// CSV format key (e.g. a bank's CSV), `stripe`, or a bank API key
  importer             String?
  /// Column mapping of the generic CSV format (`GenericCsvConfig`), when `importer` is `generic`
  importerConfig       Json?      @map("importer_config")
  defaultSegmentId     String?    @map("default_segment_id")
  /// Balance on the statement at `openingBalanceDate` (a wallet that existed before the books)
  openingBalanceDate   DateTime?  @map("opening_balance_date") @db.Date
  openingBalance       BigInt?    @map("opening_balance")
  note                 String?
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Bank API (19-bank-api §6.1): the environment connected in (`sunabar` / `stg` / `prod`); null = not connected
  bankApiEnv           String?    @map("bank_api_env")
  /// `authorized` (口座の選択待ち) / `connected` / `reauth_required`; null = not connected
  bankApiStatus        String?    @map("bank_api_status")
  /// The bank's account ID (branch and number in it): database only, never on a screen, in a log, the audit log or a backup
  bankApiAccountId     String?    @map("bank_api_account_id")
  /// The account as screens show it (「支店名 科目名 ••••末尾 4 桁」)
  bankApiAccountLabel  String?    @map("bank_api_account_label")
  /// The tokens sealed with AES-256-GCM (`v1.<iv>.<tag>.<body>`); null for the sunabar token
  bankApiTokens        String?    @map("bank_api_tokens")
  /// Last day of the period fetched so far; the next sync reads again from 3 days before it
  bankApiSyncedThrough DateTime?  @map("bank_api_synced_through") @db.Date
  /// Last sync that completed (one with nothing new included)
  bankApiLastSyncedAt  DateTime?  @map("bank_api_last_synced_at") @db.Timestamptz(6)
  /// The bank's balance and its base date (compared with the books, 19-bank-api §4)
  bankApiBalance       BigInt?    @map("bank_api_balance")
  bankApiBalanceDate   DateTime?  @map("bank_api_balance_date") @db.Date
  /// Why the last sync failed; cleared by the next one that completes
  bankApiError         String?    @map("bank_api_error")

  account                Account             @relation(fields: [accountId], references: [id])
  subAccount             SubAccount?         @relation(fields: [subAccountId], references: [id])
  defaultSegment         Segment?            @relation(fields: [defaultSegmentId], references: [id])
  stripeAccount          StripeAccountLink?
  transactions           WalletTransaction[]
  importBatches          ImportBatch[]
  rules                  Rule[]
  recurringItems         RecurringItem[]     @relation("RecurringItemWallet")
  recurringTransferItems RecurringItem[]     @relation("RecurringItemTransferWallet")
  expensePayments        ExpensePayment[]

  @@map("wallet")
}

/// Stripe account of a wallet. The account ID lives only in the database; the key in Secret Manager.
model StripeAccountLink {
  id              String    @id
  walletId        String    @unique @map("wallet_id")
  stripeAccountId String    @map("stripe_account_id")
  /// Secret Manager secret name of the restricted (read-only) key
  secretName      String    @map("secret_name")
  syncCursor      String?   @map("sync_cursor")
  lastSyncedAt    DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("stripe_account_link")
}

/// One imported statement line. Never deleted: handled lines are `ignored` instead.
model WalletTransaction {
  id              String                  @id
  walletId        String                  @map("wallet_id")
  txnDate         DateTime                @map("txn_date") @db.Date
  /// 起算日 (全銀) or Stripe `available_on`, as a JST calendar date
  valueDate       DateTime?               @map("value_date") @db.Date
  /// Time of the transaction (Stripe `created`); null for CSV
  occurredAt      DateTime?               @map("occurred_at") @db.Timestamptz(6)
  /// Signed: deposits into the wallet are positive
  amount          BigInt
  descriptionRaw  String                  @map("description_raw")
  counterpartyRaw String?                 @map("counterparty_raw")
  balanceAfter    BigInt?                 @map("balance_after")
  /// The source's own classification (Stripe `reporting_category`, 全銀 取引区分, card 支払方法)
  category        String?
  /// The original row: CSV cells, or the Stripe balance transaction (`source` as its ID)
  raw             Json?
  /// Unique within the wallet (CSV row hash or Stripe balance transaction ID)
  externalId      String                  @map("external_id")
  importBatchId   String?                 @map("import_batch_id")
  status          WalletTransactionStatus @default(pending)
  journalEntryId  String?                 @map("journal_entry_id")
  suggestion      Json?
  ignoredReason   String?                 @map("ignored_reason")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// When it was settled (registered / transfer / ignored); null while pending
  settledAt       DateTime?               @map("settled_at") @db.Timestamptz(6)
  /// The rule whose suggestion settled it (or was applied)
  ruleId          String?                 @map("rule_id")
  /// Settled by a rule without the owner (on import, or 「ルールを適用」)
  autoPosted      Boolean                 @default(false) @map("auto_posted")
  note            String?

  wallet          Wallet           @relation(fields: [walletId], references: [id])
  importBatch     ImportBatch?     @relation(fields: [importBatchId], references: [id])
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  documentLinks   DocumentLink[]
  rule            Rule?            @relation(fields: [ruleId], references: [id])
  expensePayments ExpensePayment[]

  @@unique([walletId, externalId])
  @@index([walletId, status, txnDate])
  @@index([status, txnDate])
  @@map("wallet_transaction")
}

model ImportBatch {
  id             String       @id
  walletId       String       @map("wallet_id")
  source         ImportSource
  importer       String?
  /// Name of the imported file (CSV)
  originalName   String?      @map("original_name")
  /// The imported file kept as evidence
  documentId     String?      @map("document_id")
  /// Re-importing the same file is rejected by this unique constraint
  fileSha256     String?      @unique @map("file_sha256")
  /// The imported file itself, until S6 moves it to a document (`documentId`) and drops this column
  fileBytes      Bytes?       @map("file_bytes")
  /// First and last dates of the imported lines
  periodFrom     DateTime?    @map("period_from") @db.Date
  periodTo       DateTime?    @map("period_to") @db.Date
  rowCount       Int          @default(0) @map("row_count")
  importedCount  Int          @default(0) @map("imported_count")
  duplicateCount Int          @default(0) @map("duplicate_count")
  failedCount    Int          @default(0) @map("failed_count")
  /// Rows that could not be read (`RowFailure[]`)
  failures       Json?
  /// Warnings such as a break in the statement balance (`string[]`)
  warnings       Json?
  /// Why the sync itself failed (no key, a Stripe API error); null when it completed
  error          String?
  executedBy     String       @map("executed_by")
  executedAt     DateTime     @default(now()) @map("executed_at") @db.Timestamptz(6)

  wallet       Wallet              @relation(fields: [walletId], references: [id])
  document     Document?           @relation(fields: [documentId], references: [id])
  transactions WalletTransaction[]

  @@index([walletId, executedAt])
  @@map("import_batch")
}

model Rule {
  id        String    @id
  name      String?
  /// null = every wallet
  walletId  String?   @map("wallet_id")
  /// descriptionContains / descriptionRegex / amountMin / amountMax / sign / counterpartyContains
  match     Json
  /// mode (register / transfer / ignore / suggest), accountId, taxCategoryCode, partnerId, segmentId, ...
  action    Json
  autoPost  Boolean   @default(false) @map("auto_post")
  priority  Int       @default(0)
  hitCount  Int       @default(0) @map("hit_count")
  lastHitAt DateTime? @map("last_hit_at") @db.Timestamptz(6)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallet       Wallet?             @relation(fields: [walletId], references: [id])
  transactions WalletTransaction[]

  @@map("rule")
}

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

/// Posted entries are immutable (DB triggers). Corrections: reversal + new entry.
model JournalEntry {
  id           String      @id
  fiscalYearId String      @map("fiscal_year_id")
  /// Sequential per fiscal year, no gaps (FiscalYear.nextEntryNo)
  no           Int
  entryDate    DateTime    @map("entry_date") @db.Date
  description  String
  kind         EntryKind
  sourceKind   SourceKind  @map("source_kind")
  sourceId     String?     @map("source_id")
  status       EntryStatus @default(posted)
  /// Set on reversal entries: the cancelled entry (at most one reversal per entry)
  reversalOfId String?     @unique @map("reversal_of_id")
  /// Set on a voided entry: the entry that replaces it
  replacedById String?     @map("replaced_by_id")
  voidReason   String?     @map("void_reason")
  voidedAt     DateTime?   @map("voided_at") @db.Timestamptz(6)
  createdBy    String      @map("created_by")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt     DateTime    @default(now()) @map("posted_at") @db.Timestamptz(6)

  fiscalYear              FiscalYear          @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines                   JournalLine[]
  reversalOf              JournalEntry?       @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversal                JournalEntry?       @relation("Reversal")
  replacedBy              JournalEntry?       @relation("Replacement", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replaces                JournalEntry[]      @relation("Replacement")
  walletTransactions      WalletTransaction[]
  documentLinks           DocumentLink[]
  invoices                Invoice[]
  disposedAssets          FixedAsset[]        @relation("FixedAssetDisposal")
  acquiredAssets          FixedAsset[]        @relation("FixedAssetAcquisition")
  expenseClaims           ExpenseClaim[]      @relation("ExpenseClaimEntry")
  expenseClaimReversals   ExpenseClaim[]      @relation("ExpenseClaimReversal")
  expensePayments         ExpensePayment[]    @relation("ExpensePaymentEntry")
  expensePaymentReversals ExpensePayment[]    @relation("ExpensePaymentReversal")

  @@unique([fiscalYearId, no])
  @@index([fiscalYearId, entryDate])
  @@index([sourceKind, sourceId])
  @@map("journal_entry")
}

/// Append-only (DB triggers). Debit total = credit total per entry, checked at commit.
model JournalLine {
  id              String   @id
  journalEntryId  String   @map("journal_entry_id")
  lineNo          Int      @map("line_no")
  side            Side
  accountId       String   @map("account_id")
  subAccountId    String?  @map("sub_account_id")
  /// Positive. Tax-inclusive or tax-exclusive per the fiscal year's accounting method
  amount          BigInt
  taxCategoryCode String   @map("tax_category_code")
  /// Consumption tax contained in the line
  taxAmount       BigInt   @default(0) @map("tax_amount")
  /// Required for revenue/expense/internal accounts (checked by the ledger)
  segmentId       String?  @map("segment_id")
  partnerId       String?  @map("partner_id")
  description     String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  journalEntry JournalEntry         @relation(fields: [journalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account      Account              @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subAccount   SubAccount?          @relation(fields: [subAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taxCategory  TaxCategory          @relation(fields: [taxCategoryCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  segment      Segment?             @relation(fields: [segmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  partner      Partner?             @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memoTags     JournalLineMemoTag[]

  @@unique([journalEntryId, lineNo])
  @@index([accountId])
  @@index([segmentId])
  @@map("journal_line")
}

/// Free tags on journal lines (analysis only; not part of the amounts).
model JournalLineMemoTag {
  journalLineId String   @map("journal_line_id")
  memoTagId     String   @map("memo_tag_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  journalLine JournalLine @relation(fields: [journalLineId], references: [id])
  memoTag     MemoTag     @relation(fields: [memoTagId], references: [id])

  @@id([journalLineId, memoTagId])
  @@map("journal_line_memo_tag")
}

// ---------------------------------------------------------------------------
// Evidence
// ---------------------------------------------------------------------------

/// Evidence file (GCS object). Never deleted; the stored file's identity columns are immutable.
model Document {
  id                        String         @id
  kind                      DocumentKind
  storageKey                String         @unique @map("storage_key")
  sha256                    String
  mime                      String
  byteSize                  Int            @map("byte_size")
  originalName              String?        @map("original_name")
  uploadedBy                String         @map("uploaded_by")
  uploadedAt                DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  source                    DocumentSource
  /// Search keys required by 電子帳簿保存法: date, amount, partner
  txnDate                   DateTime?      @map("txn_date") @db.Date
  amount                    BigInt?
  partnerId                 String?        @map("partner_id")
  partnerName               String?        @map("partner_name")
  invoiceRegistrationNumber String?        @map("invoice_registration_number")
  extraction                Json?
  status                    DocumentStatus @default(inbox)
  /// A replacement points to the document it supersedes (the old one becomes `voided`)
  supersedesId              String?        @map("supersedes_id")
  /// Set when voided (with the reason); never cleared (DB guard)
  voidedAt                  DateTime?      @map("voided_at") @db.Timestamptz(6)
  voidReason                String?        @map("void_reason")
  note                      String?
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner       Partner?       @relation(fields: [partnerId], references: [id])
  supersedes    Document?      @relation("Supersession", fields: [supersedesId], references: [id])
  supersededBy  Document[]     @relation("Supersession")
  links         DocumentLink[]
  importBatches ImportBatch[]
  invoicePdfs   Invoice[]
  expenseClaims ExpenseClaim[]

  /// Readings of this document (20-reader §9)
  apiUsages ExternalApiUsage[]

  @@index([txnDate, amount, partnerId])
  @@index([sha256])
  @@index([status])
  @@map("document")
}

/// Many-to-many between documents and entries / statement lines / invoices (exactly one target).
model DocumentLink {
  id                  String   @id
  documentId          String   @map("document_id")
  journalEntryId      String?  @map("journal_entry_id")
  walletTransactionId String?  @map("wallet_transaction_id")
  invoiceId           String?  @map("invoice_id")
  createdBy           String   @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document          Document           @relation(fields: [documentId], references: [id])
  journalEntry      JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id])

  @@unique([documentId, journalEntryId])
  @@unique([documentId, walletTransactionId])
  @@unique([documentId, invoiceId])
  @@index([journalEntryId])
  @@index([walletTransactionId])
  @@map("document_link")
}

// ---------------------------------------------------------------------------
// Invoices and fixed assets (v2: main columns only)
// ---------------------------------------------------------------------------

/// 見積書・納品書・請求書 (docs/design/18-invoicing.md). Only drafts change their body (DB trigger);
/// deletion is logical (`void`).
model Invoice {
  id                   String         @id
  docType              InvoiceDocType @map("doc_type")
  /// Per type and fiscal year (e.g. INV-2026-0001). Never changes on reissue
  number               String
  partnerId            String         @map("partner_id")
  issueDate            DateTime       @map("issue_date") @db.Date
  dueDate              DateTime?      @map("due_date") @db.Date
  title                String?
  /// Items: name, quantity, unit price, rate, tax category
  lines                Json
  subtotalByRate       Json           @map("subtotal_by_rate")
  taxByRate            Json           @map("tax_by_rate")
  total                BigInt
  /// Unit prices include the tax (税込) instead of excluding it (税抜)
  pricesIncludeTax     Boolean        @default(false) @map("prices_include_tax")
  /// Revenue account of an invoice (default 4040 売上高 受託開発); null for quotes and delivery notes
  revenueAccountId     String?        @map("revenue_account_id")
  /// Segment of the revenue lines (default 受託); null for quotes and delivery notes
  segmentId            String?        @map("segment_id")
  /// 備考 printed on the document
  note                 String?
  issuerSnapshot       Json?          @map("issuer_snapshot")
  /// Recipient (name, address) copied on issue
  recipientSnapshot    Json?          @map("recipient_snapshot")
  status               InvoiceStatus  @default(draft)
  /// Converted from (quote → delivery → invoice)
  sourceInvoiceId      String?        @map("source_invoice_id")
  pdfDocumentId        String?        @map("pdf_document_id")
  journalEntryId       String?        @map("journal_entry_id")
  payments             Json?
  stripePaymentLinkUrl String?        @map("stripe_payment_link_url")
  /// When the number was given (発行)
  issuedAt             DateTime?      @map("issued_at") @db.Timestamptz(6)
  /// Last time it was marked sent (送付済み)
  sentAt               DateTime?      @map("sent_at") @db.Timestamptz(6)
  /// Where it was last sent (an email address or a note)
  sentTo               String?        @map("sent_to")
  /// When it was voided or its draft discarded
  voidedAt             DateTime?      @map("voided_at") @db.Timestamptz(6)
  voidReason           String?        @map("void_reason")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner        Partner        @relation(fields: [partnerId], references: [id])
  revenueAccount Account?       @relation(fields: [revenueAccountId], references: [id], onDelete: Restrict)
  segment        Segment?       @relation(fields: [segmentId], references: [id])
  sourceInvoice  Invoice?       @relation("InvoiceConversion", fields: [sourceInvoiceId], references: [id])
  convertedTo    Invoice[]      @relation("InvoiceConversion")
  pdfDocument    Document?      @relation(fields: [pdfDocumentId], references: [id])
  journalEntry   JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  documentLinks  DocumentLink[]

  @@unique([docType, number])
  @@index([partnerId])
  @@index([status, dueDate])
  @@map("invoice")
}

model FixedAsset {
  id                        String             @id
  name                      String
  accountId                 String             @map("account_id")
  acquisitionDate           DateTime           @map("acquisition_date") @db.Date
  cost                      BigInt
  method                    DepreciationMethod
  usefulLifeYears           Int?               @map("useful_life_years")
  /// Memorandum value kept on the books (1 yen)
  residualValue             BigInt             @default(1) @map("residual_value")
  /// Depreciation per fiscal year; source of the adjusting entries
  schedule                  Json?
  /// Subject to the local depreciable assets tax (償却資産税)
  isDepreciableAssetTaxed   Boolean            @default(false) @map("is_depreciable_asset_taxed")
  segmentId                 String?            @map("segment_id")
  disposedAt                DateTime?          @map("disposed_at") @db.Date
  disposalEntryId           String?            @map("disposal_entry_id")
  /// The journal entry the asset was bought with (登録の「取得の仕訳から」 or 「仕訳も一緒に登録」)
  acquisitionEntryId        String?            @map("acquisition_entry_id")
  note                      String?
  /// Logical delete of the registration (登録の取消); the acquisition entry stays as it is
  voidedAt                  DateTime?          @map("voided_at") @db.Timestamptz(6)
  voidReason                String?            @map("void_reason")
  /// 償却資産申告の資産の種類 (第二十六号様式 1 構築物 … 6 工具、器具及び備品); null = from the account
  propertyTaxAssetType      Int?               @map("property_tax_asset_type")
  /// 償却資産申告の対象外の理由 (e.g. a vehicle under 自動車税); null = by the rules
  propertyTaxExcludedReason String?            @map("property_tax_excluded_reason")
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  account          Account       @relation(fields: [accountId], references: [id])
  segment          Segment?      @relation(fields: [segmentId], references: [id])
  disposalEntry    JournalEntry? @relation("FixedAssetDisposal", fields: [disposalEntryId], references: [id])
  acquisitionEntry JournalEntry? @relation("FixedAssetAcquisition", fields: [acquisitionEntryId], references: [id])

  @@index([acquisitionEntryId])
  @@map("fixed_asset")
}

// ---------------------------------------------------------------------------
// Plans and deadlines
// ---------------------------------------------------------------------------

/// Recurring transaction (rent, subscriptions, taxes, salaries): cash-flow input and matching hint.
model RecurringItem {
  id               String              @id
  name             String
  accountId        String              @map("account_id")
  /// Signed from the wallet's point of view: deposits are positive
  amount           BigInt
  frequency        RecurrenceFrequency
  dayOfMonth       Int?                @map("day_of_month")
  monthOfYear      Int?                @map("month_of_year")
  startDate        DateTime            @map("start_date") @db.Date
  endDate          DateTime?           @map("end_date") @db.Date
  walletId         String?             @map("wallet_id")
  /// 振替 only (21-cashflow §10.1): the other wallet; `accountId` is kept on that wallet's account
  transferWalletId String?             @map("transfer_wallet_id")
  taxCategoryCode  String?             @map("tax_category_code")
  segmentId        String?             @map("segment_id")
  partnerId        String?             @map("partner_id")
  isActive         Boolean             @default(true) @map("is_active")
  note             String?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  account        Account      @relation(fields: [accountId], references: [id])
  wallet         Wallet?      @relation("RecurringItemWallet", fields: [walletId], references: [id])
  transferWallet Wallet?      @relation("RecurringItemTransferWallet", fields: [transferWalletId], references: [id])
  taxCategory    TaxCategory? @relation(fields: [taxCategoryCode], references: [code])
  segment        Segment?     @relation(fields: [segmentId], references: [id])
  partner        Partner?     @relation(fields: [partnerId], references: [id])

  @@map("recurring_item")
}

/// Tax and legal deadlines generated from the fiscal year by rule.
model CalendarItem {
  id             String           @id
  fiscalYearId   String?          @map("fiscal_year_id")
  kind           CalendarItemKind
  title          String
  dueDate        DateTime         @map("due_date") @db.Date
  /// Identifier of the generating rule (unique per fiscal year)
  ruleKey        String?          @map("rule_key")
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  completedBy    String?          @map("completed_by")
  note           String?
  /// Last day a reminder mail went out (7 days before and on/after the due date)
  lastNotifiedOn DateTime?        @map("last_notified_on") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  fiscalYear FiscalYear? @relation(fields: [fiscalYearId], references: [id])

  @@unique([fiscalYearId, ruleKey])
  @@index([dueDate])
  @@map("calendar_item")
}

// ---------------------------------------------------------------------------
// Audit and users
// ---------------------------------------------------------------------------

/// Append-only history of every change (電子帳簿保存法の訂正・削除の履歴). UPDATE/DELETE are rejected.
model AuditLog {
  id       String   @id
  at       DateTime @default(now()) @db.Timestamptz(6)
  /// Email of the IAP-authenticated user, or `system` / `seed`
  actor    String
  action   String
  entity   String
  entityId String?  @map("entity_id")
  before   Json?
  after    Json?
  reason   String?

  @@index([entity, entityId])
  @@index([at])
  @@map("audit_log")
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      UserRole @default(owner)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  expenseClaims   ExpenseClaim[]
  expensePayments ExpensePayment[]

  @@map("app_user")
}

// ---------------------------------------------------------------------------
// Payroll (docs/design/22-payroll.md §5)
// ---------------------------------------------------------------------------

/// 役員 (役員報酬) or 従業員 (給料手当).
enum EmployeeKind {
  officer
  employee

  @@map("employee_kind")
}

/// 甲欄 (扶養控除等申告書あり) or 乙欄.
enum WithholdingColumn {
  kou
  otsu

  @@map("withholding_column")
}

/// 社会保険料の控除の月: 翌月控除 (the previous month's premium) or 当月控除.
enum PremiumTiming {
  next_month
  same_month

  @@map("premium_timing")
}

/// 従業員 (役員を含む). Personal data is kept minimal: no My Number, address or bank account.
/// Never deleted: deactivated instead. Changes are in the audit log (employee.create / update).
model Employee {
  id                String            @id
  /// 表示名 on the payslip and the screens
  name              String
  kind              EmployeeKind
  /// Only for the age rules of 介護・厚年・健保 (22-payroll §2.9)
  birthDate         DateTime          @map("birth_date") @db.Date
  /// 毎月の課税支給額 (役員報酬・基本給): the default of a pay run
  basePay           BigInt            @map("base_pay")
  /// 毎月の通勤手当 (non-taxable part): the default of a pay run
  commuteAllowance  BigInt            @default(0) @map("commute_allowance")
  /// 健康保険・厚生年金の被保険者
  socialInsured     Boolean           @map("social_insured")
  /// 資格取得日: premiums from the month it belongs to (required when socialInsured)
  insuredFrom       DateTime?         @map("insured_from") @db.Date
  /// 標準報酬月額 (健保), a grade amount (required when socialInsured)
  healthSmr         BigInt?           @map("health_smr")
  /// 標準報酬月額 (厚年), a grade amount (required when socialInsured)
  pensionSmr        BigInt?           @map("pension_smr")
  /// 雇用保険の被保険者 (never for an officer)
  employmentInsured Boolean           @map("employment_insured")
  taxColumn         WithholdingColumn @map("tax_column")
  /// 扶養親族等の数 (甲欄), or the number on 従たる給与の申告書 (乙欄)
  dependents        Int               @default(0)
  /// 住民税の月額 (特別徴収): the default of a pay run
  residentTax       BigInt            @default(0) @map("resident_tax")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("employee")
}

/// A confirmed pay run (1 per pay month). Append-only (DB triggers): corrections are made by the
/// adjustments of a later run or by correcting its entries.
model PayrollRun {
  id                    String        @id
  /// 支給月 (YYYY-MM) = the month of paymentDate
  payMonth              String        @unique @map("pay_month")
  /// 支払日: the date of the entries and the year of the withholding table
  paymentDate           DateTime      @map("payment_date") @db.Date
  /// Fixed by the first run
  premiumTiming         PremiumTiming @map("premium_timing")
  /// 対象月 (YYYY-MM) of the premiums deducted: each premium month is deducted once
  premiumMonth          String        @unique @map("premium_month")
  /// 支払元の口座; null = 未払金〔給与〕
  payFromWalletId       String?       @map("pay_from_wallet_id")
  /// 源泉所得税の納期の特例
  withholdingSpecialDue Boolean       @map("withholding_special_due")
  /// 住民税の納期の特例
  residentTaxSpecialDue Boolean       @map("resident_tax_special_due")
  /// Ids of the table versions used (withholding / kenpo / pension / employment)
  tableIds              Json          @map("table_ids")
  /// Per person: input and result, amounts as strings (22-payroll §5.5)
  items                 Json
  /// 1 本目 (本人分)
  payEntryId            String        @map("pay_entry_id")
  /// 2 本目 (会社負担); null when it is 0
  employerEntryId       String?       @map("employer_entry_id")
  confirmedAt           DateTime      @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy           String        @map("confirmed_by")

  @@map("payroll_run")
}

// ---------------------------------------------------------------------------
// 立替精算 (docs/design/23-users-and-expenses.md §5)
// ---------------------------------------------------------------------------

/// 未払 / 支払済み / 取消済み.
enum ExpenseClaimStatus {
  submitted
  paid
  void

  @@map("expense_claim_status")
}

/// One receipt a user paid for the company. Submitting posts 科目 / 未払金〔立替精算〕 on the day it
/// was spent; paying posts 未払金〔立替精算〕 / 口座 (ExpensePayment). Never deleted: a claim is voided
/// with a reversal (DB trigger); after the submission only the state columns change.
model ExpenseClaim {
  id              String             @id
  /// 立替えた人
  claimantId      String             @map("claimant_id")
  /// 利用日: the date of the accrual entry
  spentOn         DateTime           @map("spent_on") @db.Date
  /// Tax-inclusive, positive
  amount          BigInt
  accountId       String             @map("account_id")
  taxCategoryCode String             @map("tax_category_code")
  segmentId       String?            @map("segment_id")
  partnerId       String?            @map("partner_id")
  /// 内容
  description     String
  /// 証憑 (linked to the accrual entry on submission)
  documentId      String?            @map("document_id")
  status          ExpenseClaimStatus @default(submitted)
  /// 計上の仕訳
  journalEntryId  String             @map("journal_entry_id")
  /// The payment in force (set while paid)
  paymentId       String?            @map("payment_id")
  voidReason      String?            @map("void_reason")
  voidedAt        DateTime?          @map("voided_at") @db.Timestamptz(6)
  /// The reversal of the accrual entry (取消); null when it was voided on the transaction screen first
  reversalEntryId String?            @map("reversal_entry_id")
  createdBy       String             @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  claimant      User            @relation(fields: [claimantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taxCategory   TaxCategory     @relation(fields: [taxCategoryCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  segment       Segment?        @relation(fields: [segmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  partner       Partner?        @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document      Document?       @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  journalEntry  JournalEntry    @relation("ExpenseClaimEntry", fields: [journalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment       ExpensePayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversalEntry JournalEntry?   @relation("ExpenseClaimReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status])
  @@index([claimantId])
  @@index([paymentId])
  @@index([journalEntryId])
  @@map("expense_claim")
}

/// One payment of a claimant's claims in one entry (未払金〔立替精算〕 / 口座). Never deleted: a payment
/// is cancelled with a reversal (DB trigger); only the cancellation columns are set, once.
model ExpensePayment {
  id                  String    @id
  claimantId          String    @map("claimant_id")
  /// 支払日: the date of the payment entry (the statement line's date when one was matched)
  paidOn              DateTime  @map("paid_on") @db.Date
  /// 支払元 (an active bank or cash wallet)
  walletId            String    @map("wallet_id")
  /// The statement line the payment was matched with (registered with the payment entry)
  walletTransactionId String?   @map("wallet_transaction_id")
  /// The total of the claims
  amount              BigInt
  /// 支払の仕訳
  journalEntryId      String    @map("journal_entry_id")
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason        String?   @map("cancel_reason")
  /// The reversal of the payment entry; null when it was voided on the transaction screen first
  reversalEntryId     String?   @map("reversal_entry_id")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  claimant          User               @relation(fields: [claimantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wallet            Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  journalEntry      JournalEntry       @relation("ExpensePaymentEntry", fields: [journalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversalEntry     JournalEntry?      @relation("ExpensePaymentReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  claims            ExpenseClaim[]

  @@index([claimantId])
  @@index([journalEntryId])
  @@map("expense_payment")
}

// ---------------------------------------------------------------------------
// External API usage (docs/design/20-reader-and-registry.md §7.1・§9)
// ---------------------------------------------------------------------------

/// One row per call of an external API (a reading, a registry lookup). Append-only (DB triggers).
model ExternalApiUsage {
  id           String   @id
  at           DateTime @default(now()) @db.Timestamptz(6)
  /// `reader` | `registry`
  service      String
  /// `anthropic` / `recorded` / `nta` / `fixture`
  provider     String
  model        String?
  documentId   String?  @map("document_id")
  /// `ok` | `failed`
  outcome      String
  error        String?
  requestCount Int      @default(1) @map("request_count")
  /// Numbers looked up (registry)
  itemCount    Int      @default(0) @map("item_count")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  /// 10⁻⁹ USD
  costNanoUsd  BigInt   @default(0) @map("cost_nano_usd")
  actor        String

  document Document? @relation(fields: [documentId], references: [id])

  @@index([service, at])
  @@map("external_api_usage")
}

// ---------------------------------------------------------------------------
// Payroll: 賞与 (docs/design/22-payroll.md §10)
// ---------------------------------------------------------------------------

/// A confirmed bonus run (1 per pay month, apart from the monthly PayrollRun). Append-only (DB
/// triggers): corrections are made by correcting its entries.
model PayrollBonusRun {
  id                    String   @id
  /// 支給月 (YYYY-MM) = the month of paymentDate (also the premium month of its premiums)
  payMonth              String   @unique @map("pay_month")
  /// 支払日: the date of the entries and the year of the withholding tables
  paymentDate           DateTime @map("payment_date") @db.Date
  /// 題名 (夏季賞与 など): in the entries' descriptions
  title                 String
  /// 賞与の計算期間が 6 か月を超える (the monthly-table exceptions use ÷ 12 / × 12)
  calcPeriodOver6Months Boolean  @map("calc_period_over_6_months")
  /// 支払元の口座; null = 未払金〔給与〕
  payFromWalletId       String?  @map("pay_from_wallet_id")
  /// 源泉所得税の納期の特例
  withholdingSpecialDue Boolean  @map("withholding_special_due")
  /// Ids of the table versions used (bonus / monthly withholding / kenpo / pension / employment)
  tableIds              Json     @map("table_ids")
  /// Per person: input and result, amounts as strings (22-payroll §5.5・§10)
  items                 Json
  /// 1 本目 (本人分)
  payEntryId            String   @map("pay_entry_id")
  /// 2 本目 (会社負担); null when it is 0
  employerEntryId       String?  @map("employer_entry_id")
  confirmedAt           DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy           String   @map("confirmed_by")

  @@map("payroll_bonus_run")
}
