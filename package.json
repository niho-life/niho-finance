{
  "name": "niho-finance",
  "version": "0.0.0",
  "private": true,
  "description": "NIHO finance: double-entry ledger, imports and reports for a small company",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm -C packages/db run generate",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:db": "npm -C packages/db run test:db --",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm -C packages/db run generate --",
    "db:migrate": "npm -C packages/db run migrate:deploy --",
    "db:migrate:dev": "npm -C packages/db run migrate:dev --",
    "db:seed": "npm -C packages/db run seed --",
    "db:reset": "npm -C packages/db run migrate:reset --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
