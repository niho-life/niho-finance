# Deployment configuration. Copy to scripts/deploy.env (ignored by git) and fill in the real values.
# Never commit deploy.env: the repository is public and these values identify the production project.
# All values are examples.

GCP_PROJECT=my-gcp-project
GCP_REGION=asia-northeast1
# Existing Cloud SQL instance (PostgreSQL) in the same project; the database niho_finance is created in it.
CLOUDSQL_INSTANCE=my-sql-instance
# Direct VPC egress (the Cloud SQL instance has a private IP only).
VPC_NETWORK=default
VPC_SUBNET=default

# Names of the resources (defaults of docs/ops/deploy.md §1).
ARTIFACT_REPO=niho-finance
WEB_SERVICE=niho-finance
JOBS_SERVICE=niho-finance-jobs
MIGRATE_JOB=niho-finance-migrate
RUNNER_SA=niho-finance-runner
SCHEDULER_SA=niho-finance-scheduler
# Cloud Tasks queue of scripts/run-job.sh (manual job runs).
# The web service also puts 受け渡しパッケージ (large handover zips) on it (docs/ops/deploy.md §6).
TASKS_QUEUE=niho-finance-manual
# Bucket names are global: prefix them with the project.
DOCUMENTS_BUCKET=my-gcp-project-finance-documents
BACKUPS_BUCKET=my-gcp-project-finance-backups

# Custom domain of the web service (docs/ops/deploy.md §10). Empty = the run.app URL.
APP_URL=

# Who may open the app through IAP (comma-separated IAM members).
IAP_MEMBERS=user:owner@example.com

# Mail: notifications are sent from MAIL_FROM via SMTP (password in Secret Manager) to MAIL_TO.
MAIL_FROM=finance@example.com
MAIL_TO=owner@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=finance@example.com
# Where Cloud Monitoring sends the two alerts.
ALERT_EMAIL=owner@example.com
