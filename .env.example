# Local development defaults (docker compose). Copy to `.env` at the repository root.
# These are throwaway local values, not secrets.
DATABASE_URL="postgresql://niho:niho_dev_password@localhost:5433/niho_finance?schema=public"

# Environment name shown on the web app (local / prod).
NIHO_FINANCE_ENV=local

# Who the web app writes as (audit log `actor` of Server Actions). Defaults to `owner`;
# S8 replaces it with the email of the IAP-authenticated user.
NIHO_FINANCE_ACTOR=owner

# Where evidence files (証憑) are stored: GCS when NIHO_FINANCE_DOCUMENTS_BUCKET is set (production;
# scripts/deploy.sh sets it), a local folder otherwise. NIHO_FINANCE_STORAGE=local|gcs forces one.
# NIHO_FINANCE_ENV=prod refuses the local folder.
# NIHO_FINANCE_DOCUMENTS_BUCKET=
# NIHO_FINANCE_STORAGE=
# local: the folder for the files. Defaults to <repo root>/tmp/documents (git-ignored).
# NIHO_FINANCE_STORAGE_DIR=
# local: the key that signs upload URLs. Defaults to a random key per process (fine for dev).
# NIHO_FINANCE_UPLOAD_SECRET=

# --- 明細の取込（S4, docs/design/12-imports.md §4.1・§5・§6.4） ---
# Stripe の制限付きキー（読み取り専用）。取込の設定で口座に登録する「鍵の名前」がこの変数名。
# ローカルはテストモードの rk_test_ キー。本番は Cloud Run の --set-secrets で Secret Manager から結ぶ。
# NIHO_FINANCE_STRIPE_KEY_PLATFORM=
# NIHO_FINANCE_STRIPE_KEY_KAMAKURA=

# ジョブ（/api/jobs/*）の認証。Cloud Scheduler の OIDC トークンの aud と、そのサービスアカウントのメール。
# NIHO_FINANCE_JOB_AUDIENCE=
# NIHO_FINANCE_JOB_SERVICE_ACCOUNT=
# ローカル専用: この値を Bearer に入れた要求もジョブとして受け付ける（NIHO_FINANCE_ENV=prod では無視）。
# NIHO_FINANCE_JOB_TOKEN=

# --- 証憑の読み取りと登録番号の照合（#18, docs/design/20-reader-and-registry.md §2.2・§8.2） ---
# API キーとアプリケーション ID は、ローカルは .env、本番は Cloud Run の --set-secrets で Secret Manager から結ぶ
# （ここに値を書かない）。recorded と fixture は開発用で、本番では使われない。
# Anthropic の API キー。あれば読み取りが既定で anthropic になり、なければ読み取りの操作は出ない。
# ANTHROPIC_API_KEY=
# 読み取りの provider: anthropic / recorded / off。既定は ANTHROPIC_API_KEY があれば anthropic、なければ off。
# recorded は記録済みの応答を返す開発用で、NIHO_FINANCE_ENV=prod では使われない（off 扱い）。
# NIHO_FINANCE_READER_PROVIDER=
# 読み取りのモデル: claude-haiku-5-5（既定・軽量）/ claude-sonnet-5-5。一覧にない名前は設定の誤りとして off 扱い。
# NIHO_FINANCE_READER_MODEL=
# recorded のときの記録ファイル（JSON）のパス。既定は packages/reader/fixtures/receipts/recorded.json。
# NIHO_FINANCE_READER_RECORDINGS=
# 国税庁 適格請求書発行事業者公表システム Web-API のアプリケーション ID（13 桁。オーナーが申請する）。
# なければ照合の操作は出ず、登録番号は形式と検査用数字だけを確かめる。
# NIHO_FINANCE_NTA_APPLICATION_ID=
# fixture で架空の公表情報を使う開発用の切替（NIHO_FINANCE_ENV=prod では無視される）。
# NIHO_FINANCE_NTA_MODE=
