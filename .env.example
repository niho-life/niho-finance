# Local development defaults (docker compose). Copy to `.env` at the repository root.
# These are throwaway local values, not secrets. Empty values count as unset.
DATABASE_URL="postgresql://niho:niho_dev_password@localhost:5433/niho_finance?schema=public"

# Environment name (local / prod). `prod` requires the IAP signed header on every write.
NIHO_FINANCE_ENV=local

# Which Cloud Run service this is (web / jobs). `/api/jobs/*` runs only on `jobs`; `web` answers 404.
NIHO_FINANCE_SERVICE=web

# Audience of the IAP signed header (`x-goog-iap-jwt-assertion`), set by scripts/deploy.sh on Cloud Run:
# /projects/<project number>/locations/<region>/services/<service>. Leave empty locally.
NIHO_FINANCE_IAP_AUDIENCE=

# Who the web app writes as (audit log `actor`) when there is no IAP header (local only). Defaults to `owner`.
NIHO_FINANCE_ACTOR=owner

# Mail: `log` writes the mail to the log instead of sending it (local); `smtp` sends it.
NIHO_FINANCE_MAIL=log
NIHO_FINANCE_MAIL_FROM=books@example.com
# Recipients of the deadline notices (comma-separated).
NIHO_FINANCE_MAIL_TO=owner@example.com
# SMTP (only with NIHO_FINANCE_MAIL=smtp). Port 465 is TLS from the start; other ports require STARTTLS.
NIHO_FINANCE_SMTP_HOST=smtp.gmail.com
NIHO_FINANCE_SMTP_PORT=465
NIHO_FINANCE_SMTP_USER=
# An app password (Secret Manager on Cloud Run). Never commit it.
NIHO_FINANCE_SMTP_PASSWORD=

# Daily export (POST /api/jobs/backup): a GCS bucket on Cloud Run, or a local folder (an absolute
# path; a relative one is relative to the server's working directory, apps/web for `npm -C apps/web run dev`).
NIHO_FINANCE_BACKUP_BUCKET=
NIHO_FINANCE_BACKUP_DIR=

# The screens' URL, put at the end of notice mails.
NIHO_FINANCE_APP_URL=http://localhost:3000

# The deployed commit (backup manifest and /api/health). Set by scripts/deploy.sh.
NIHO_FINANCE_GIT_SHA=
