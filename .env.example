# Local development defaults (docker compose). Copy to `.env` at the repository root.
# These are throwaway local values, not secrets. Empty values count as unset.
DATABASE_URL="postgresql://niho:niho_dev_password@localhost:5433/niho_finance?schema=public"

# Environment name (local / prod). `prod` requires the IAP signed header on every write.
NIHO_FINANCE_ENV=local

# Which Cloud Run service this is (web / jobs). `/api/jobs/*` runs only on `jobs`; `web` answers 404.
NIHO_FINANCE_SERVICE=web

# Audience of the IAP signed header (`x-goog-iap-jwt-assertion`), set by scripts/deploy.sh on Cloud Run:
# /projects/<project number>/locations/<region>/services/<service>. Leave empty locally.
NIHO_FINANCE_IAP_AUDIENCE=

# Who the web app writes as (audit log `actor`) when there is no IAP header (local only). It must be
# one of the users (設定 › 利用者); `owner@example.com` is the seed's 管理者 and the default.
NIHO_FINANCE_ACTOR=owner@example.com

# Mail: `log` writes the mail to the log instead of sending it (local); `smtp` sends it.
NIHO_FINANCE_MAIL=log
NIHO_FINANCE_MAIL_FROM=books@example.com
# Recipients of the deadline notices (comma-separated).
NIHO_FINANCE_MAIL_TO=owner@example.com
# SMTP (only with NIHO_FINANCE_MAIL=smtp). Port 465 is TLS from the start; other ports require STARTTLS.
NIHO_FINANCE_SMTP_HOST=smtp.gmail.com
NIHO_FINANCE_SMTP_PORT=465
NIHO_FINANCE_SMTP_USER=
# An app password (Secret Manager on Cloud Run). Never commit it.
NIHO_FINANCE_SMTP_PASSWORD=

# Daily export (POST /api/jobs/backup): a GCS bucket on Cloud Run, or a local folder (an absolute
# path; a relative one is relative to the server's working directory, apps/web for `npm -C apps/web run dev`).
NIHO_FINANCE_BACKUP_BUCKET=
NIHO_FINANCE_BACKUP_DIR=

# The screens' URL, put at the end of notice mails.
NIHO_FINANCE_APP_URL=http://localhost:3000

# The deployed commit (backup manifest and /api/health). Set by scripts/deploy.sh.
NIHO_FINANCE_GIT_SHA=

# Where evidence files (証憑) are stored: GCS when NIHO_FINANCE_DOCUMENTS_BUCKET is set (production;
# scripts/deploy.sh sets it), a local folder otherwise. NIHO_FINANCE_STORAGE=local|gcs forces one.
# NIHO_FINANCE_ENV=prod refuses the local folder.
# NIHO_FINANCE_DOCUMENTS_BUCKET=
# NIHO_FINANCE_STORAGE=
# local: the folder for the files. Defaults to <repo root>/tmp/documents (git-ignored).
# NIHO_FINANCE_STORAGE_DIR=
# local: the key that signs upload URLs. Defaults to a random key per process (fine for dev).
# NIHO_FINANCE_UPLOAD_SECRET=

# --- 明細の取込（S4, docs/design/12-imports.md §4.1・§5・§6.4） ---
# Stripe の制限付きキー（読み取り専用）。取込の設定で口座に登録する「鍵の名前」がこの変数名。
# ローカルはテストモードの rk_test_ キー。本番は Cloud Run の --set-secrets で Secret Manager から結ぶ。
# NIHO_FINANCE_STRIPE_KEY_PLATFORM=
# NIHO_FINANCE_STRIPE_KEY_KAMAKURA=

# ジョブ（/api/jobs/*）の認証。Cloud Scheduler の OIDC トークンの aud と、そのサービスアカウントのメール。
# NIHO_FINANCE_JOB_AUDIENCE=
# NIHO_FINANCE_JOB_SERVICE_ACCOUNT=
# ローカル専用: この値を Bearer に入れた要求もジョブとして受け付ける（NIHO_FINANCE_ENV=prod では無視）。
# NIHO_FINANCE_JOB_TOKEN=

# --- 証憑の読み取りと登録番号の照合（#18, docs/design/20-reader-and-registry.md §2.2・§8.2） ---
# API キーとアプリケーション ID は、ローカルは .env、本番は Cloud Run の --set-secrets で Secret Manager から結ぶ
# （ここに値を書かない）。recorded と fixture は開発用で、本番では使われない。
# Anthropic の API キー。あれば読み取りが既定で anthropic になり、なければ読み取りの操作は出ない。
# ANTHROPIC_API_KEY=
# 読み取りの provider: anthropic / recorded / off。既定は ANTHROPIC_API_KEY があれば anthropic、なければ off。
# recorded は記録済みの応答を返す開発用で、NIHO_FINANCE_ENV=prod では使われない（off 扱い）。
# NIHO_FINANCE_READER_PROVIDER=
# 読み取りのモデル: claude-haiku-5-5（既定・軽量）/ claude-sonnet-5-5。一覧にない名前は設定の誤りとして off 扱い。
# NIHO_FINANCE_READER_MODEL=
# recorded のときの記録ファイル（JSON）のパス。既定は packages/reader/fixtures/receipts/recorded.json。
# NIHO_FINANCE_READER_RECORDINGS=
# 国税庁 適格請求書発行事業者公表システム Web-API のアプリケーション ID（13 桁。オーナーが申請する）。
# なければ照合の操作は出ず、登録番号は形式と検査用数字だけを確かめる。
# NIHO_FINANCE_NTA_APPLICATION_ID=
# fixture で架空の公表情報を使う開発用の切替（NIHO_FINANCE_ENV=prod では無視される）。
# NIHO_FINANCE_NTA_MODE=

# --- 銀行 API（v2 #17, docs/design/19-bank-api.md §5） ---
# 環境: sunabar / stg（検証）/ prod（本番）。未設定なら銀行 API は使わない（CSV で取り込む）。
# NIHO_FINANCE_GMO_AOZORA_ENV=
# トークンの方式（sunabar）: sunabar ポータルの「開発者向け」で発行したアクセストークン。
# NIHO_FINANCE_GMO_AOZORA_ACCESS_TOKEN=
# 認可の方式（stg・prod。sunabar の認可利用）: 接続通知書のクライアント。本番は Secret Manager から結ぶ。
# NIHO_FINANCE_GMO_AOZORA_CLIENT_ID=
# NIHO_FINANCE_GMO_AOZORA_CLIENT_SECRET=
# GMO に登録したクライアント認証方式（basic が既定、post）とリダイレクト URI（…/api/bank/gmo-aozora/callback）。
# NIHO_FINANCE_GMO_AOZORA_CLIENT_AUTH=
# NIHO_FINANCE_GMO_AOZORA_REDIRECT_URI=
# トークンの暗号鍵（32 バイトの base64。openssl rand -base64 32）。本番は Secret Manager から結ぶ。
# NIHO_FINANCE_BANK_TOKEN_KEY=
# URL の上書き（https の *.gmo-aozora.com。NIHO_FINANCE_ENV=local では http://localhost も可）。
# NIHO_FINANCE_GMO_AOZORA_API_BASE=
# NIHO_FINANCE_GMO_AOZORA_AUTH_BASE=
